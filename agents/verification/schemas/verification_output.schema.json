{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_report",
    "verdict",
    "repair_hints",
    "checked_item_ids",
    "proof_digest",
    "context_digest"
  ],
  "properties": {
    "verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "critical_errors",
        "gaps"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "critical_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "correct",
        "wrong"
      ]
    },
    "repair_hints": {
      "type": "string"
    },
    "checked_item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^pi_[0-9a-f]{24}$"
      }
    },
    "proof_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "issue"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "correct"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "verification_report": {
            "properties": {
              "critical_errors": {
                "maxItems": 0
              },
              "gaps": {
                "maxItems": 0
              }
            }
          },
          "repair_hints": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "wrong"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "verification_report": {
            "anyOf": [
              {
                "properties": {
                  "critical_errors": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "gaps": {
                    "minItems": 1
                  }
                }
              }
            ]
          },
          "repair_hints": {
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
